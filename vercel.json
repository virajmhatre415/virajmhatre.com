{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/etl/simulate", "destination": "/api/etl-simulate" },
    { "source": "/api/sql/tune", "destination": "/api/sql-tune" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
